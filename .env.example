# ---- TMDB ----------------------------------------------------------------
# v3 API key (query-string auth, fine for prototyping)
TMDB_API_KEY=your_tmdb_v3_api_key
# Optional: v4 "API Read Access Token". When set, it takes precedence and is
# sent as `Authorization: Bearer ...` (recommended for production).
TMDB_READ_TOKEN=

# ---- Site ----------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.example.com
NEXT_PUBLIC_SITE_NAME=CineFlow

# ---- Adsterra (leave empty to disable a format) --------------------------
# Full script URLs copied from Adsterra > Websites > Get code
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_SRC=
NEXT_PUBLIC_ADSTERRA_POPUNDER_SRC=
# Banner keys (the 32-char hex key inside atOptions)
NEXT_PUBLIC_ADSTERRA_BANNER_300X250_KEY=
NEXT_PUBLIC_ADSTERRA_BANNER_728X90_KEY=
# Banner script base = the second <script src> minus the key, e.g. https://xxxx.org/22
NEXT_PUBLIC_ADSTERRA_BANNER_BASE=
# Max Social Bar impressions per visitor per day (client-side cap)
NEXT_PUBLIC_ADSTERRA_SOCIAL_BAR_DAILY_CAP=2

# ---- Google Search Console (HTML tag verification, content only) --------
NEXT_PUBLIC_GSC_VERIFICATION=
